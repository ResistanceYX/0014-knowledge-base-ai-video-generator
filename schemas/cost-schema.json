{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/0014-knowledge-base-ai-video-generator/cost-schema-0.1.0.json",
  "title": "离线脚本成本记录与可选 M3 媒体成本",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSnapshotSha256", "mode", "externalCalls", "optionalServicesPricing", "localCompute", "retries", "manualRevisionRounds"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "sourceSnapshotSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"const": "offline-template"},
    "externalCalls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count", "apiFees"],
      "properties": {
        "status": {"const": "none"},
        "count": {"const": 0},
        "apiFees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "note"],
          "properties": {
            "amount": {"const": 0},
            "currency": {"type": "null"},
            "note": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "optionalServicesPricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "queriedAt", "note"],
      "properties": {
        "status": {"const": "unknown"},
        "queriedAt": {"type": "null"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "localCompute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durationMs", "monetaryCost", "note"],
      "properties": {
        "status": {"const": "measured"},
        "durationMs": {"type": "number", "minimum": 0},
        "monetaryCost": {"const": "not-estimated"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "retries": {"type": "integer", "minimum": 0},
    "manualRevisionRounds": {"type": "integer", "minimum": 0},
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "speechMode", "speechExternalCalls", "speechRetries", "speechApiFees", "renderCount", "localRebuildCount", "renderDurationMs", "speechDurationMs", "generatedClipCount", "manualAudioReplacements", "manualSubtitleOverrides", "note"],
      "properties": {
        "schemaVersion": {"const": "0.3.0"},
        "speechMode": {"enum": ["none", "fixture", "edge-tts"]},
        "speechExternalCalls": {"type": "integer", "minimum": 0},
        "speechRetries": {"type": "integer", "minimum": 0},
        "speechApiFees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "amount", "currency", "note"],
          "properties": {
            "status": {"enum": ["unknown", "not-run"]},
            "amount": {"type": "null"},
            "currency": {"type": "null"},
            "note": {"type": "string", "minLength": 1}
          }
        },
        "renderCount": {"type": "integer", "minimum": 0},
        "localRebuildCount": {"type": "integer", "minimum": 0},
        "renderDurationMs": {"type": "number", "minimum": 0},
        "speechDurationMs": {"type": "number", "minimum": 0},
        "generatedClipCount": {"type": "integer", "minimum": 0},
        "manualAudioReplacements": {"type": "integer", "minimum": 0},
        "manualSubtitleOverrides": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}

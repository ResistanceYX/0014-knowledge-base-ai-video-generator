{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/0014-knowledge-base-ai-video-generator/source-map-schema-0.1.0.json",
  "title": "逐句来源映射 Schema（M1 0.1.0）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "sourceSnapshotSha256",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceSnapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceMapEntry"
      }
    }
  },
  "$defs": {
    "sourceMapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "sceneId",
        "supportStatus",
        "sources",
        "qualifiers",
        "openQuestion",
        "review"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "pattern": "^seg-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sceneId": {
          "type": "string",
          "pattern": "^scene-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "supportStatus": {
          "enum": [
            "supported",
            "partially-supported",
            "needs-evidence",
            "not-applicable"
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/nodeFieldSource"
          }
        },
        "qualifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "openQuestion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "supportStatus": {
                "enum": [
                  "supported",
                  "partially-supported"
                ]
              }
            },
            "required": [
              "supportStatus"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supportStatus": {
                "enum": [
                  "needs-evidence",
                  "not-applicable"
                ]
              }
            },
            "required": [
              "supportStatus"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supportStatus": {
                "enum": [
                  "partially-supported",
                  "needs-evidence"
                ]
              }
            },
            "required": [
              "supportStatus"
            ]
          },
          "then": {
            "properties": {
              "openQuestion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "nodeFieldSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "jsonPointer",
        "excerpt",
        "fieldRole"
      ],
      "properties": {
        "kind": {
          "const": "node-field"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "fieldRole": {
          "enum": [
            "metadata",
            "evidence",
            "reasoning",
            "limit",
            "reusable-part",
            "other"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "approved",
            "changes-requested"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
